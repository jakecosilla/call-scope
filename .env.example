# CallScope Application Configuration Example

APP_ENV=local
LOG_LEVEL=INFO

# Backend API Configuration
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET_KEY=change_this_secret_in_production_32bytes_hex

# Evaluator Login Credentials
EVALUATOR_USERNAME=evaluator@example.com
EVALUATOR_PASSWORD=change-me-in-your-local-env

# ML Pipeline & Azure Cost Parameters
DEFAULT_APPROACH=approach_a
CPU_CONTAINER_APP_COST_PER_SEC=0.000036
MEMORY_GIB_COST_PER_SEC=0.000004
CONTAINER_MEMORY_GIB=2
MAX_CONCURRENT_INFERENCE=1
SQLITE_DB_PATH=/tmp/callscope/callscope.db
