# CallScope Application Configuration Example

APP_ENV=local
LOG_LEVEL=INFO

# Backend API Configuration
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET_KEY=change_this_secret_in_production_32bytes_hex

# Evaluator Login Credentials
EVALUATOR_USERNAME=evaluator@callscope.ai
EVALUATOR_PASSWORD=your_secure_password_here

# ML Pipeline & Azure Cost Parameters
DEFAULT_APPROACH=approach_a
CPU_CONTAINER_APP_COST_PER_SEC=0.000036
AUDIO_RETENTION_DAYS=7
